<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="22dp" app:cardElevation="3dp" app:strokeColor="@color/colorOutline" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/TextAppearance.HospitalApp.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consulta médica" />
        <TextView style="@style/TextAppearance.HospitalApp.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="18dp" android:text="Asigna al médico y registra la atención" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Médico responsable" android:textColor="@color/colorTextDark" android:textSize="13sp" android:textStyle="bold" />
        <Spinner android:id="@+id/spinnerMedico" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="7dp" android:background="@drawable/bg_spinner" android:spinnerMode="dropdown" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Detalles de la consulta" app:startIconDrawable="@drawable/ic_medical_note">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDiagnosticoConsulta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:minLines="4" android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvHoraSalida" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_status_chip" android:text="Hora de salida: no seleccionada" android:textColor="@color/colorPrimaryDark" android:textSize="13sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSeleccionarHoraSalida" style="@style/Widget.HospitalApp.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Seleccionar hora de salida" app:icon="@drawable/ic_clock" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardarConsulta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Guardar consulta" app:icon="@drawable/ic_medical_note" app:backgroundTint="@color/colorPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
