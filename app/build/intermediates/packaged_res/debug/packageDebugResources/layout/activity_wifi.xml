<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/colorBackground">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="210dp" android:gravity="bottom" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_header_gradient">
        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_soft_circle" android:padding="13dp" android:src="@drawable/ic_wifi" android:contentDescription="WiFi" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Conexión Wi‑Fi" android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Información de la red activa" android:textColor="#D9F2F4" android:textSize="14sp" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" app:cardCornerRadius="22dp" app:cardElevation="3dp" app:strokeColor="@color/colorOutline" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tvSsid" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:background="@color/colorSurfaceVariant" android:text="SSID: -" android:textColor="@color/colorTextDark" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvBssid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@color/colorSurfaceVariant" android:text="BSSID: -" android:textColor="@color/colorTextDark" android:textSize="15sp" />
            <TextView android:id="@+id/tvVelocidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@color/colorSurfaceVariant" android:text="Velocidad de enlace: -" android:textColor="@color/colorTextDark" android:textSize="15sp" />
            <TextView android:id="@+id/tvIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@color/colorSurfaceVariant" android:text="Dirección IP: -" android:textColor="@color/colorTextDark" android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
