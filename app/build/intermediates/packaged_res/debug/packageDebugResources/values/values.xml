<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#16A085</color>
    <color name="colorAccentDark">#0E7563</color>
    <color name="colorBackground">#F4F8FA</color>
    <color name="colorOutline">#C7D5DA</color>
    <color name="colorPrimary">#0B5D6B</color>
    <color name="colorPrimaryContainer">#D9F2F4</color>
    <color name="colorPrimaryDark">#073E48</color>
    <color name="colorSecondary">#4E6E81</color>
    <color name="colorSuccess">#178A63</color>
    <color name="colorSurface">#FFFFFF</color>
    <color name="colorSurfaceVariant">#EAF1F4</color>
    <color name="colorTextDark">#17333D</color>
    <color name="colorTextLight">#7B9098</color>
    <color name="colorTextMedium">#536B75</color>
    <color name="colorWarning">#D98E1E</color>
    <color name="ic_launcher_background">#0B5D6B</color>
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Hospital App</string>
    <style name="ShapeAppearance.HospitalApp.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
    <style name="TextAppearance.HospitalApp.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/colorTextDark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="TextAppearance.HospitalApp.Subtitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/colorTextMedium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.HospitalApp.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/colorTextDark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Theme.HospitalApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextDark</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.HospitalApp.Button</item>
        <item name="textInputStyle">@style/Widget.HospitalApp.TextInputLayout</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.HospitalApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="iconPadding">12dp</item>
        <item name="rippleColor">@color/colorPrimaryContainer</item>
    </style>
    <style name="Widget.HospitalApp.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="iconTint">@color/colorPrimary</item>
    </style>
    <style name="Widget.HospitalApp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/colorTextMedium</item>
        <item name="android:textColorHint">@color/colorTextMedium</item>
        <item name="startIconTint">@color/colorPrimary</item>
        <item name="endIconTint">@color/colorPrimary</item>
    </style>
</resources>