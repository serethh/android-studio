<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurface" />
            <stroke android:width="1dp" android:color="@color/colorOutline" />
            <corners android:radius="16dp" />
            <padding android:left="14dp" android:top="10dp" android:right="44dp" android:bottom="10dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="16dp" android:drawable="@drawable/ic_expand_more" />
</layer-list>
